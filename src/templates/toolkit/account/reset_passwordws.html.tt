<div id="change-password" class="grd-grid-12">

	<!--

	Known issues:

	0. Yes, these comments are temporary and will be removed.

	1. The validation rules we enforce on the password is not the exact rules
	the previous onsubmit handler used. There has been a rule checking for 
	character type that is not included here. The regexp and error description
	for that check is:

		RegExp('^[ -~]+$');
		'Your password contains invalid characters.'
	There is an open question about this posted to backend news group.

	2. Not sure in what circumstances the following paragraphs are displayed. 
	I Will ask. I am including them here in these comments for now:

		<p calss="if-ask">Please take a moment to verify your identity by providing us with your date of birth, below.</p>

		<p class="failed-msg">Your account is important to us. Please <a href="">contact us</a> should you need further assistance.</p>

	-->

	<form class="form">

		<h1>[% l('Change Password') %]</h1>

		<fieldset>
        	
          	<div class="grd-row-padding old-password">

            	<div class="grd-grid-4 form_label">
              		<label for="oldpassword">[% l('Current password') %]</label>
            	</div>

            	<div class="grd-grid-8">
              		<input type="password" name="oldpassword" />
              		<p class="hint">[% l('Enter your current password') %]</p>
              		<p data-id="old-password-not-correct" class="errorfield hidden">[% l('This is not your current password.') %]</p>
            	</div>

          	</div>
          	
          	<div class="grd-row-padding new-password">

            	<div class="grd-grid-4 form_label">
              		<label for="new-password">[% l('New password') %]</label>
            	</div>

            	<div class="grd-grid-8">
              		
              		<input type="password" name="new-password" />

              		<p class="hint">[% l('Select a new password between 6 to 25 characters. You cannot use non-printable characters.') %]</p>
 
              		<p data-error="same-as-old" class="errorfield hidden">[% l('New password is same as old password.') %]</p>
             		
              		<p data-error="too-short" class="errorfield hidden">[% l('Password should be at least 6 characters long.') %]</p>

              		<p data-error="too-long" class="errorfield hidden">[% l('Password should be maximum 25 characters long.') %]</p>

              		<p data-error="bad-chars" class="errorfield hidden">[% l('Your password contains invalid characters.') %]</p>

            	</div>
          	</div>

          	<div class="grd-row-padding repeat-password">
            	<div class="grd-grid-4 form_label">
              		<label for="repeat-password">[% l('New password') %]</label>
            	</div>
            	<div class="grd-grid-8">
              		
              		<input type="password" name="repeat-password" />

              		<p class="hint">[% l('Type in your password again.') %]</p>
              		
              		<p data-error="not-the-same" class="errorfield hidden">[% l('The two passwords that you entered do not match.') %]</p>

            	</div>
          	</div>

          	<div class="grd-row-padding">
            	<div class="grd-grid-4"></div>
            	<div class="grd-grid-8">
              		<span class="button">
                		<button class="button-disabled">[% l('Change Password') %]</button>
              		</span>
            	</div>
          	</div>

        </fieldset>

    </form><!-- form ends -->

	<div data-id="success-result" class="hidden">
		<h1>[% l('Password Changed!') %]</h1>
		<p class="success-msg">[% l('Your password has been successfully reset. Please log into your account using your new password.') %]</p>
	</div>
	
</div><!-- #change-password ends -->
