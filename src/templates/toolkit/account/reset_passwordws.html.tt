<div class="grd-grid-12">
	<h1></h1>

	[% IF action == 'ask' %]

	<p calss="if-ask">[% l('Please take a moment to verify your identity by providing us with your date of birth, below.') %]</p>
	[% recovery_form.build() %]

	[% ELSIF action == 'answer' %]

	<p>[% l('Please type your chosen password twice into the fields below:') %]</p>
	[% new_password_form.build() %]

	[% ELSIF action == 'recover' %]

	<p>[% l('Please type your chosen password twice into the fields below:') %]</p>
	[% new_password_form.build() %]
	<p>[% l('Your account is important to us. Please <a href="[_1]">contact us</a> should you need further assistance.',
		request.url_for('contact')) %]</p>

		[% ELSIF action == 'pass' %]

		[% xxx = l('Your password has been successfully reset. Please log into your account using your new password.') %]
		[% INCLUDE global/client_message.html.tt content = xxx %]

		<script>setInterval(function() { window.location = "[% request.url_for('/login', {email => $email}) %]"; }, 5000);</script>

		[% END %]
	</div>


	<div id="change-password" class="grd-grid-12">
		
		<fieldset>
        	
        	<legend>[% l('Password reset') %]WS</legend>

          	<div class="grd-row-padding old-password">
            	<div class='grd-grid-4 form_label'>
              		<label for='oldpassword'>[% l('Current password') %]</label>
            	</div>
            	<div class='grd-grid-8'>
              		<input type='password' name='oldpassword' />
              		<p class='hint'>[% l('Enter your current password') %]</p>
              		<p data-id="old-password-not-correct" class='errorfield'>[% l('This is not your current password.') %]</p>
            	</div>
          	</div>
          	
          	<div class="grd-row-padding old-password">
            	<div class='grd-grid-4 form_label'>
              		<label for='oldpassword'>[% l('New password') %]</label>
            	</div>
            	<div class='grd-grid-8'>
              		<input type='password' name='oldpassword' />
              		<p class='hint'>[% l('Select a new password between 5 to 25 characters. You cannot use these characters:') %]<pre> -~</pre></p>
              		<p data-id="old-password-not-correct" class='errorfield'>[% l('Password should be at least 5 characters long.') %]</p>
              		<p data-id="old-password-not-correct" class='errorfield'>[% l('Password should be at least 5 characters long.') %]</p>
            	</div>
          	</div>

          	<div class="grd-row-padding">
            	<div class='grd-grid-4'></div>
            	<div class='grd-grid-8'>
              		<span class='button'>
                		<button class='button' name='submit' type='submit'>[% l('Change Password') %]</button>
              		</span>
            	</div>
          	</div>

        </fieldset>





		<form class="grd-row-padding" id="changePasswordForm" onsubmit="UserWS.requestPassReset();">
			
			<div class="rbox form">
				<div class="rbox-wrap">
					<fieldset>
						<div class="grd-row-padding row clear">
							<div class="grd-grid-4  form_label">
								<label for="oldpassword">Current password</label>
							</div>
							<div class="grd-grid-8">
								<input class=" text" id="oldpassword" maxlength="25" name="oldpassword" type="password" autocomplete="off">
								<p class="errorfield" id="erroroldpassword"></p>
							</div>
						</div>
						<div class="grd-row-padding row clear">
							<div class="grd-grid-4  form_label">
								<label for="npassword">New Password</label>
							</div>
							<div class="grd-grid-8">
								<input class=" text" id="npassword" maxlength="25" name="npassword" type="password">
								<p class="errorfield" id="errornpassword"></p>
							</div>
						</div>
						<div class="grd-row-padding row clear">
							<div class="grd-grid-4  form_label">
								<label for="npassword2">Verify new password</label>
							</div>
							<div class="grd-grid-8">
								<input class=" text" id="npassword2" maxlength="25" name="npassword2" type="password">
								<p class="errorfield" id="errornpassword2"></p>
							</div>
						</div>
						<div class="grd-row-padding row clear">
							<div class="grd-grid-8">
								<input id="l" name="l" type="hidden" value="EN">
							</div>
						</div>
						<div class="grd-row-padding row clear">
							<div class="grd-grid-4 grd-hide-mobile form_label">
								<label></label>
							</div>
							<div class="grd-grid-8">
								<span class=" button">
									<button class=" button" id="submit" name="submit" type="submit" value="Change Password">Change Password</button>
								</span>
							</div>
						</div>
					</fieldset>
					<span class="tl">&nbsp;</span>
					<span class="tr">&nbsp;</span>
					<span class="bl">&nbsp;</span>
					<span class="br">&nbsp;</span>
				</div>
			</div>
			<input type="hidden" name="csrftoken" value="e86d08f5e846343ae6b3fa89e7e249c8414f2e2e"></form>
		</div>

