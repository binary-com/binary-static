<div id="live_chart_options">
    <ul id="live_chart_duration">
        <li id="600" class="live_charts_stream_button" data-live='1min'>
            <span class="button button-small">[% l("1min") %]</span>
        </li>
        <li id="3600" class="live_charts_stream_button" data-live='5min'>
            <span class="button button-small">[% l("5min") %]</span>
        </li>
        <li id="21600" class="live_charts_stream_button" data-live='15min'>
            <span class="button button-small">[% l("15min") %]</span>
        </li>
        <li id="43200" class="live_charts_stream_button" data-live='1h'>
            <span class="button button-small">[% l("1h") %]</span>
        </li>
        <li id="86400" class="live_charts_stream_button" data-live='4h'>
            <span class="button button-small">[% l("4h") %]</span>
        </li>
        <li id="172800" class="live_charts_stream_button" data-live='1d'>
            <span class="button button-small">[% l("1d") %]</span>
        </li>
    </ul>
</div>
