<div class="gr-padding-30">
<div class="gr-12">
    <h1>[% l('Login trouble') %]</h1>
    <p class="">[% l('If you\'re experiencing difficulties logging into your account, please verify that cookies are enabled in your browser. This website uses cookies to store your login ID and password (in encrypted format) on your PC during your login session.') %]</p>
    <p class="">[% l('To enable cookies, follow the instructions below for the browser version that you use:') %]</p>
</div>

<div class="gr-parent clear">
    <div class="gr-row">
        <div class="gr-6 gr-12-m">
            <a id="chrome" target="_blank" href="http://www.google.com/chrome/" class="li-boxes-content-icon">Binary (C.R.) S.A.</a>
            <div class="li-2-boxes-content li-boxes-content-extra-height">
                <h2>Chrome 51+</h2>
                [% l('<ul><li>Go to <strong>Chrome</strong> menu and select <strong>Preferences</strong>.</li><li>Click on <strong>Show advanced settings</strong> at the bottom on the page.</li><li>Under <strong>Privacy</strong> section, click <strong>Content settings...</strong>.</li><li>Select <strong>Allow local data to be set (recommended)</strong>.</li><li>Click <strong>Finished</strong> to save your settings.</li></ol>') %]
            </div>
        </div>

        <div class="gr-6 gr-12-m">
            <a id="firefox" target="_blank" href="http://www.mozilla.com/en-US/firefox/firefox.html" class="li-boxes-content-icon">Binary (IOM) Ltd</a>
            <div class="li-2-boxes-content li-boxes-content-extra-height">
                <h2>Mozilla Firefox 47+</h2>
                [% l('<ul><li>Go to <strong>Firefox</strong> menu and select <strong>Preferences</strong>.</li><li>Click on <strong>Privacy</strong> tab.</li><li>Under <strong>History</strong> section, set <i>Firefox will: </i> to <strong> Remember history</strong>.</li><li>Click <strong>OK</strong> to save your settings.</li></ul>') %]
            </div>
        </div>
    </div>
</div>

<div class="gr-parent clear">
    <div class="gr-row">
        <div class="gr-6 gr-12-m">
            <a id="safari" target="_blank" href="http://www.apple.com/safari/" class="li-boxes-content-icon">Binary (Europe) Ltd</a>
            <div class="li-2-boxes-content li-boxes-content-extra-height">
                <h2>Safari 9.x+</h2>
                [% l('<ul><li>Go to <strong>Safari</strong> menu and select <strong>Preferences</strong>.</li><li>Click on <strong>Privacy</strong> tab. </li><li>Set <i>Block cookies:</i> to <strong>Never</strong>. </li><li>Click <strong>X</strong> at the top right to save your settings.</li></ul>') %]
            </div>
        </div>

        <div class="gr-6 gr-12-m">
            <a id="opera" target="_blank" href="http://www.opera.com/" class="li-boxes-content-icon">Binary (C.R.) S.A.</a>
            <div class="li-2-boxes-content li-boxes-content-extra-height">
                <h2>Opera 38+</h2>
                [% l('<ul><li>Go to <strong>Tools</strong> menu and select <strong>Preferences</strong>. </li><li>Click on <strong>Advanced</strong> tab. </li><li>Select <strong>Cookies</strong> from the left column. </li><li>Select <strong>Accept cookies</strong>. </li><li>Click <strong>OK</strong> to save your settings.</li></ul>') %]
            </div>
        </div>
    </div>
</div>

<div class="gr-parent">
    <div class="gr-row">
        <div class="gr-6 gr-12-m">
            <a id="internet_explorer" target="_blank" href="http://www.microsoft.com/windows/internet-explorer/default.aspx" class="li-boxes-content-icon">Binary Ltd</a>
            <div class="li-2-boxes-content li-boxes-content-extra-height">
                <h2>Microsoft Internet Explorer 11+</h2>
                [% l('<ul><li>Go to <strong>Tools</strong> menu and select <strong>Internet Options</strong>. </li><li>Click on <strong>Privacy</strong> tab.</li><li>Click <strong>Advanced</strong>. </li><li>Select <strong>Override automatic cookie handling</strong>. </li><li>Select <strong>Accept</strong> for both <strong>First-party Cookies</strong> and <strong>Third-party Cookies</strong>. </li><li>Click <strong>OK</strong> to save your settings. </li></ul>') %]
            </div>
        </div>

        <div class="gr-6 gr-12-m">
            <a id="microsoft_edge" target="_blank" href="https://www.microsoft.com/en-us/download/details.aspx?id=48126" class="li-boxes-content-icon">Binary Ltd</a>
            <div class="li-2-boxes-content li-boxes-content-extra-height" style="margin-top: 1em;">
                <h2>Microsoft Edge 12+</h2>
                [% l('<ul><li>Go to  <strong>More actions</strong> menu and select <strong>Settings</strong>. </li><li>Under <strong>Advanced Settings</strong>, click on <strong>View advanced settings</strong>. </li><li>Under <strong>Cookies</strong> section, select <strong>Don\'t block cookies</strong>.</li><li>Click anywhere outside the menu to save your settings.</li></ul>') %]
            </div>
        </div>
    </div>
</div>
</div>