  .seen-on .light-text{text-align:center;color:#888;margin:0;}
  #help{padding:30px;border-bottom: 1px solid #c2c2c2;}
  .accent-color1{color:#e98024;}
  .text-center{text-align:center;}
  .referral-box{ position: relative; margin: 40px 0; text-align: left; font-size: 0.8em; color: #3A5167; background-color: rgba(42, 48, 82, 0.15); padding: 27px; border-radius: 4px; }
  .referral-box p, .signature{position:relative;margin:0}
  .referral-box .signature{font-style:italic;color:#8E96A4;position: absolute;right: 24px;}
  .comm{position:absolute;font-size:23em;color:#EBEDF4;}
  .open-comm{top: -61px;left: -23px;}
  .close-comm{top: 19px;right: -21px;}
  .box-wrap{
      min-height:485px;
      background: rgba(255,255,255,0.3);
      /*box-shadow: 0 0 8px 0 rgba(0,0,0,0.2),   inset 0 0 1px 0 rgba(255,255,255,1);*/
      margin:  20px auto;
      border-radius: 3px;
      border: solid 1px #E4E4E4;
  }
  .box-wrap header{ width: 100%;
                    background-color: #EBEDF4;
                    border-radius: 4px 4px 0 0;
                    box-shadow:0px 3px 5px -2px rgba(0,0,0,0.2)}
  .box-wrap .title{color:#2a3052;min-height:60px;}
  .box-wrap .padding{padding:12px;}
  .box-wrap .body p{color:#454a63;}
  .box-wrap .body{padding-bottom:43px}
  .box-wrap .body-bg{min-height:184px;background-color:rgba(235, 237, 244, 0.29);border-top: solid #E4E4E4 2px;border-bottom: solid #E4E4E4 2px;}
  .box-wrap .img-w{margin-top:-27px;text-align:center;}
  .box-wrap .img-w img{width:115px;padding:12px;max-width:100%;}
  .box-wrap.signup{overflow:auto;background-color:#e98024;}
  .box-wrap.signup header{background-color:#e98024;}
  .box-wrap.signup header h3{margin-top: 31px;margin-bottom: -8px;padding:0px;}
  .box-wrap.signup header .title{color:#fff;}
  .box-wrap.signup header .tri-down {border-bottom:solid 1px #fff}
  .box-wrap.signup header .tri-down:after {
                                border-top-color: #fff;
                              }
  .tri-down {
      /* Styling block element, not required */
      position: relative;
      margin-bottom: 2em;
      padding: 0em;
      border-bottom: 0px solid #999;
      background: #f3f3f3;
    }
    /* Required for Down Triangle */
    .tri-down:before, .tri-down:after {
      content: "";
      position: absolute;
      width: 0;
      height: 0;
      border-style: solid;
      border-color: transparent;
      border-bottom: 0;
    }
    /* Fill */
    .tri-down:after {
      bottom: -20px;
      left: 44%;
      border-top-color: #EBEDF4;
      border-width: 20px;
    }
