:javascript
  var resetH=function(elems){
    var hArr=[]
    elems.each(function(i,el){
      hArr.push($(el).height())
    })
    var maxH=Math.max(hArr)
    elems.height(maxH)
    console.log("HHH!")
  }
  var elems=$(.box-wrap)
  $(function(){
    $(window).resize(function(){resetH()})
  })
