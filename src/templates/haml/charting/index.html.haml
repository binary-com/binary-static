- stash(
-   title => l('Charting'),
- );

.grd-grid-12.ja-hide
  %h1= l('Charting')
  %p= l('[_1] provides a variety of charts to help you determine what markets to trade on. Try them out.',stash->{website_name})
.grd-grid-6.grd-grid-mobile-12.grd-parent
  .grd-grid-6.grd-parent
    .grd-grid-8.grd-with-padding
      %a.pjaxload{:href => '//highcharts.binary.com'}
        %img.responsive.chart-type-icon{:src => url_for('images/pages/charting/highcharts.svg')}
    .grd-grid-12
      %h4
        %a.pjaxload{:href => '//highcharts.binary.com'}= l('HighCharts')
      %p= l('[_1]’s fully-featured charting platform.',stash->{website_name})
  .grd-grid-6.grd-parent
    .grd-grid-8.grd-with-padding
      %a.pjaxload{:href => '//tradingview.binary.com'}
        %img.responsive.chart-type-icon{:src => url_for('images/pages/charting/light-charts.svg')}
    .grd-grid-12
      %h4
        %a.pjaxload{:href => '//tradingview.binary.com'}= l('TradingView')
      %p= l('Advanced technical analysis platform (daily charts only).')
