[% BLOCK link %]
    [% FOREACH favicon IN favicons %]
        [% sizes=favicon.size _ 'x' _ favicon.size %]
    <link rel="[% (favicon.is_image ? '' : 'apple-touch-') _ 'icon' %]" sizes="[% sizes %]"[% IF favicon.is_image %] type="image/png"[% END %] href="https://style.binary.com/images/favicons/[% favicon.is_image ? 'fav' : 'apple-touch-' %]icon-[% sizes %].png">
    [% END %]
[% END %]

[% PROCESS components/elements.html.tt %]
[% PROCESS components/tabs.html.tt %]
[% BLOCK payment_logo %]
    [% FOREACH item IN items %]
        <div class="gr-2 gr-4-m gr-centered center-text">
            <img class="payment-icons" src="[% request.url_for('images/signup_landing_page/icons/payment_methods/' _ item _ '.svg') %]"></img>
        </div>
    [% END %]
[% END %]

[% BLOCK arrows %]
    <div class="align-self-center gr-1 gr-hide-m">
        <img class="go-[% direction %] gr-10 gr-centered" data-parent="[% parent %]" src="[% request.url_for('images/signup_landing_page/icons/slider/arrow_' _ direction _ '.svg') %]">
    </div>
[% END %]

[% BLOCK markets_tab_content %]
    <div class="gr-row gr-row-align-middle">
       [% INCLUDE arrows parent="market_tabs" direction="left" %]
        <div class="gr-5 gr-12-m gr-parent">
            <strong>[% header %]</strong>
            <p>[% text %]</p>
        </div>
        <div class="gr-5 gr-12-m gr-parent center-text">
            <img class="responsive market-img" src="[% request.url_for(image) %]" />
        </div>
        [% INCLUDE arrows parent="market_tabs" direction="right" %]
    </div>
[% END %]

<!DOCTYPE html>
<html>
    <head>
        [% INCLUDE global/anti_clickjack.html.tt %]
        <meta http-equiv="Content-Type" content="text/html;charset=UTF-8" />
        <meta http-equiv="Content-Language" content="[%= iso639a_language =%]" />
        <meta name="description" content="[%= broker_name =%]" />
        <meta name="keywords" content="binary options, forex, forex trading, online trading, financial trading, binary trading, index trading, trading indices, forex trades, trading commodities, binary options strategy, binary broker, binary bet, binary options trading platform, binary strategy, finance, stocks, investment, trading, hackathon" />
        <meta name="author" content="[%= broker_name =%]" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
        <meta name="dcterms.rightsHolder" content="[%= broker_name =%]" />
        <meta name="dcterms.rights" content="[%= broker_name =%]" />
        <meta property="og:title" content="[%= broker_name =%]" />
        <meta property="og:type" content="website" />
        <meta property="og:image" content="[% request.url_for('images/common/og_image.gif') %]" />

        [% PROCESS global/title.html.tt %]

        [% INCLUDE link favicons=[
            { size='57' },
            { size='114' },
            { size='72' },
            { size='144' },
            { size='60' },
            { size='120' },
            { size='76' },
            { size='152' },
            { size='180' },
            { is_image=1, size='192' },
            { is_image=1, size='160' },
            { is_image=1, size='96' },
            { is_image=1, size='16' },
            { is_image=1, size='32' },
        ] %]
        <link rel="stylesheet" href="https://style.binary.com/binary.css" />
        <link href="[% request.url_for('css/signup-landing.css') _ '?' _ static_hash %]" rel="stylesheet" />
        <script src="https://code.jquery.com/jquery-2.1.1.min.js" integrity="sha256-h0cGsrExGgcZtSZ/fRz4AwV+Nn6Urh/3v3jFRQ0w9dQ=" crossorigin="anonymous"></script>
        <script src="https://style.binary.com/binary.js"></script>
        <script src="[% request.url_for('js/landing_pages/common.js') _ '?' _ static_hash %]"></script>
        <script src="[% request.url_for('js/landing_pages/signup_landing_page.js') _ '?' _ static_hash %]"></script>
    </head>
    <body>
        [% PROCESS global/gtm.html.tt %]
        <div class="intro intro-bg">
            <div class ="container">
                <div class="gr-row gr-row-align-center">
                    <div class="gr-12-m">
                      <div class="gr-12 gr-centered center-text">
                        <a target="_blank" href="https://www.binary.com">
                            <img class="logo" src="[% request.url_for('images/signup_landing_page/main/binary-logo.svg') %]"></img>
                        </a>
                      </div>
                      <div class="gr-12">
                        <h1 class="center-text mb-2">[% l('The Premier Platform for Online Trading') %]</h1>
                        <p class="white-text center-text">[% l('Sign up for a risk-free virtual account and start trading with instant access to $10,000 in virtual funds.') %]</p>
                      </div>
                    </div>
                </div>
                <div class="gr-12 sign-up-form">
                [% WRAPPER global/form_verify_email.html.tt class='secondary-bg-color' dark_button=1 text=l('Create Free Account') %]
                    <div class="invisible" id="success">
                        <div class="gr-padding-10 center-text hint gr-12">
                            [% l('Thank you for signing up! Please check your email to complete the registration process.') %]
                        </div>
                    </div>
                [% END %]
              </div>
            </div>
            <div class="hero-section">
                <div class="container">
                    <div class="gr-row gr-row-align-center mt-5">
                        <div class="gr-4 gr-12-m gr-centered">
                            <div class="hero-icons center-text">
                                <img src="[% request.url_for('images/signup_landing_page/main/licensed_and_regulated.svg') %]"></img>
                            </div>
                            <h3 class="white-text center-text">[% l('Licensed and Regulated') %]</h3>
                            <div class="hero-text">
                                <p class="white-text center-text">[% l('Binary.com is licensed and regulated in Malta, the British Isles, Japan, and Vanuatu.') %]</p>
                            </div>
                        </div>
                        <div class="gr-4 gr-12-m gr-centered">
                            <div class="hero-icons center-text">
                                <img src="[% request.url_for('images/signup_landing_page/main/global_presence.svg') %]"></img>
                            </div>
                            <h3 class="white-text center-text">[% l('Global Presence') %]</h3>
                            <div class="hero-text">
                                <p class="white-text center-text">[% l('Binary.com employs over 130 people across its offices in Malta, Malaysia and Japan.') %]</p>
                            </div>
                        </div>
                        <div class="gr-4 gr-12-m gr-centered">
                            <div class="hero-icons center-text">
                                <img src="[% request.url_for('images/signup_landing_page/main/extensive_product_range.svg') %]"></img>
                            </div>
                            <h3 class="white-text center-text">[% l('Extensive Product Range') %]</h3>
                            <div class="hero-text">
                                <p class="white-text center-text">[% l('Over 100 asset classes across Forex, CFDs, and binary options.') %]</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        [% INCLUDE global/separator_line.html.tt class="gr-padding-20" invisible=1 show_mobile=1 %]

        <div class="container tab-markets">
            <h2 class="center-text gr-padding-10">[% l("Trade in the world's financial markets") %]</h2>
            <div id="market_tabs_selector"></div>
            [% WRAPPER tab_container class='gr-padding-30 gr-parent full-width' theme='light' %]
                [% INCLUDE tabs_subtabs id='market_tabs' class='gr-padding-20 gr-parent' items=[
                    { id='binary', text=l('Binary options'), class='active' },
                    { id='forex',  text=l('Forex') },
                    { id='cfds',   text=l('CFDs') },
                    { id='metals', text=l('Metals') },
                    { id='crypto', text=l('Crypto') },
                ] %]
                <div class="tab-content mt-2">
                    [% WRAPPER tab_content_container %]
                        [% WRAPPER tab_content id='binary' visible=1 %]
                            [% INCLUDE markets_tab_content header=l("Binary options") text=l("Options that offer a fixed payout based on a simple yes/no proposition.")
                                image="images/pages/signup_landing_page/icons/trade/Binary_image.svg" %]
                        [% END %]
                        [% WRAPPER tab_content id='forex' %]
                            [% INCLUDE markets_tab_content header=l("Forex") text=l("Major, minor and exotic currency pairs.")
                                image="images/pages/signup_landing_page/icons/trade/Forex_Image.svg" %]
                        [% END %]
                        [% WRAPPER tab_content id='cfds' %]
                            [% INCLUDE markets_tab_content header=l("CFDs") text=l("Derivatives that reflect the movement of underlying assets.")
                                image="images/pages/signup_landing_page/icons/trade/CFDs_Image.svg" %]
                        [% END %]
                        [% WRAPPER tab_content id='metals' %]
                            [% INCLUDE markets_tab_content header=l("Metals") text=l("Precious metal pairs including gold (XAU/USD) and platinum (XPT/USD).")
                                image="images/pages/signup_landing_page/icons/trade/Metals_Image.svg" %]
                        [% END %]
                        [% WRAPPER tab_content id='crypto' %]
                            [% INCLUDE markets_tab_content header=l("Cryptocurrencies") text=l("Cryptocurrency pairs including Bitcoin (BTC/USD), Ethereum (ETH/USD), and Litecoin (LTC/USD).")
                                image="images/pages/signup_landing_page/icons/trade/Crypto_Image.svg" %]
                        [% END %]
                    [% END %]
                </div>
            [% END %]
        </div>
        <div class="market-footer-text">
            <div class="container">
                <h3 class="center-text gr-padding-30">[% l("Choose from 100+ tradable instruments, backed by award-winning technology and innovation since 2000.") %]</h3>
            </div>
        </div>
        <div class="gr-padding-10 fill-bg-color">
            <div class="container gr-padding-20">
                <div class="gr-row">
                    <div class="gr-3 gr-12-m align-self-center center-text-m gr-padding-10">
                        <h3 class="no-margin center-text">[% l("Award-winning trading excellence") %]</h3>
                    </div>
                    <div class="gr-9 gr-12-m align-self-center">
                        <div class="gr-row gr-row-align-center">
                            <div class="gr-1 gr-hide-m border-right"></div>
                            <div class="gr-2 gr-3-m align-self-center gr-padding-10"><img class="gr-10 gr-centered" src="[% request.url_for('images/signup_landing_page/icons/awards/awards-t2w.png') %]"></div>
                            <div class="gr-2 gr-3-m align-self-center gr-padding-10"><img class="gr-11 gr-centered" src="[% request.url_for('images/signup_landing_page/icons/awards/why-us-GBAF-award-2012.svg') %]"></div>
                            <div class="gr-2 gr-3-m align-self-center gr-padding-10"><img class="responsive" src="[% request.url_for('images/signup_landing_page/icons/awards/awards-opwa.svg') %]"></div>
                            <div class="gr-2 gr-3-m align-self-center gr-padding-10"><img class="gr-10 gr-centered" src="[% request.url_for('images/signup_landing_page/icons/awards/awards-mena.png') %]"></div>
                            <div class="gr-2 gr-3-m align-self-center gr-padding-10"><img class="gr-10 gr-centered" src="[% request.url_for('images/signup_landing_page/icons/awards/awards-egr.png') %]"></div>
                            <div class="gr-1 gr-hide-m"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="payment">
            <div class="container">
                <div class="gr-row gr-row-align-center">
                    <div class="gr-12">
                        <h2 class="center-text">[% l('Payment Methods') %]</h2>
                    </div>
                </div>
                <div class="gr-row gr-row-align-center">
                    [% INCLUDE payment_logo items=[
                    'ic-visa',
                    'ic-mastercard',
                    'ic-bank-transfer',
                    'ic-internet-bank-transfer',
                    'ic-western-union',
                    'ic-internet-banking',
                    'ic-skrill',
                    'ic-neteller',
                    'ic-moneta',
                    'ic-webmoney',
                    'ic-ukash',
                    'ic-instadebit',
                    'ic-qiwi',
                    'ic-clickandbuy',
                    'ic-verified-visa',
                    'ic-union-pay',
                    'ic-mastercard-securecode',
                    'ic-icbc',
                    'ic-yandex',
                    'ic-fasapay',
                    'ic-perfect-money',
                    'ic-cashu',
                    'ic-ok-pay',
                    'ic-paysafe-card',
                    'ic-bitcoin',
                    'ic-bitcoin-cash',
                    'ic-litecoin',
                    'ic-ethereum',
                    'ic-ethereum-classic',
                    ] %]
                </div>
            </div>
        </div>
        <div class="footer">
            <div class="container">
                <div class="gr-row gr-row-align-center">
                    <div class="gr-12 gr-centered">
                        <p class="center-text white-text">Trading binary options may not be suitable for everyone, so please ensure that you fully understand the risks involved. Your losses can exceed your initial deposit and you do not own or have any interest in the underlying asset. In regards to binary options which are gambling products, remember that gambling can be addictive - please play responsibly. Read about Responsible Trading.</p>
                    </div>
                </div>
            </div>
        </div>
    </body>
</html>
