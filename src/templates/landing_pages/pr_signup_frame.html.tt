<!DOCTYPE html>
<html>
<head>
    [% FOREACH css_file IN css_files =%]
        <link rel="stylesheet" href="[%= css_file =%]" />
    [% END %]
    <style type="text/css">
        body {
            background: transparent;
            display: flex;
            flex-direction: column;
            font-size: 18px;
        }
        .center {
            margin-top: auto;
            margin-bottom: auto;
        }
        input[type='text'], input[type='submit'] {
            padding: 10px;
            border-radius: 3px;
            margin: 5px;
            width: 95%;
        }
        input[type='text'] {
            border: 1px solid #F2F2F2;
            color: #000;
        }
        input[type='submit'] {
            height: auto !important;
            background: #2E8836;
            color: #FFF;
            border: none;
            cursor: pointer;
            -webkit-appearance: none;
            -moz-appearance: none;
        }
        input[type='submit']:hover {
             background: #14602B;
        }
        input[type='text']:focus, input[type='submit']:focus {
            outline: none;
        }
    </style>
    <script src="[% request.url_for('js/landing_pages/common.js') _ '?' _ static_hash %]"></script>
    <script src="[% request.url_for('js/landing_pages/pr_signup_frame.js') _ '?' _ static_hash %]"></script>
</head>
<body>
[% PROCESS global/gtm.html.tt %]
<div class="center">
    <!-- AWeber Web Form Generator 3.0.1 -->
    <form id="frm_pr_signup" method="post" class="af-form-wrapper" accept-charset="UTF-8" action="https://www.aweber.com/scripts/addlead.pl">
        <div style="display: none;">
            <input type="hidden" name="meta_web_form_id" value="382779290" />
            <input type="hidden" name="meta_split_id" value="" />
            <input type="hidden" name="listname" value="awlist4830742" />
            <input type="hidden" name="redirect" value="" id="redirect_6c667668ff5e97e481530a3726044f95" />

            <input type="hidden" name="meta_adtracking" value="get_paid_for_PR" />
            <input type="hidden" name="meta_message" value="1001" />
            <input type="hidden" name="meta_required" value="email" />

            <input type="hidden" name="meta_tooltip" value="email||Enter your email" />
        </div>
        <div id="af-form-382779290" class="af-form">
            <div id="af-body-382779290" class="af-body af-standards">
                <div class="af-element gr-row">
                    <div class="gr-7 gr-11-m">
                        <input id="email" class="text" id="awf_field-93544706" type="text" name="email" placeholder="Enter your email" tabindex="500" onfocus=" if (this.value == 'Enter your email') { this.value = ''; }" onblur="if (this.value == '') { this.value='Enter your email';} " />
                    </div>
                    <div class="gr-5 gr-push-2-m gr-8-m">
                        <input class="submit" type="submit" value="Submit" tabindex="501" />
                    </div>
                </div>
            </div>
        </div>
        <div style="display: none;"><img src="https://forms.aweber.com/form/displays.htm?id=zBxM7OycTJwM" alt="" /></div>
    </form>
    <script type="text/javascript">document.getElementById('redirect_6c667668ff5e97e481530a3726044f95').value = document.location + "#done";</script>
    <!-- /AWeber Web Form Generator 3.0.1 -->

    <div class="invisible" id="success">
        <div class="gr-padding-10 center-text hint gr-12 align-self-center">
            [% l('Thank you for signing up! Please check your email to complete the registration process.') %]
        </div>
    </div>
</div>
</body>
</html>
